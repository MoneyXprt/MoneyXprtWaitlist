# ─── LOCAL DEVELOPMENT ───────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your keys.
# The MLS CFO Analytics feature (/mls) only needs OPENAI_API_KEY.

# Skips Supabase auth entirely — safe for local testing
NEXT_PUBLIC_SKIP_AUTH=true

# Required for the AI Social Post Generator on the /mls page
OPENAI_API_KEY=sk-...your-key-here...

# ─── OPTIONAL (only needed for financial planner / dashboard features) ────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# DATABASE_URL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
